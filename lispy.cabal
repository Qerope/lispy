name:                lispy
version:             0.1.0.0
build-type:          Simple
cabal-version:       >=1.10

executable lispy
  main-is:             Main.hs
  hs-source-dirs:      src
  other-modules:       Parser, Types
  build-depends:       base >= 4.7 && < 5
                     , parsec >= 3.1
  default-language:    Haskell2010
  ghc-options:         -Wall
